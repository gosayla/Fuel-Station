{
  "name": "fuel-station",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node ./node_modules/turbo/bin/turbo run dev",
    "build": "node ./node_modules/turbo/bin/turbo run build",
    "lint": "node ./node_modules/turbo/bin/turbo run lint",
    "test": "node ./node_modules/turbo/bin/turbo run test",
    "dev:web": "node ./node_modules/turbo/bin/turbo run dev --filter=web",
    "dev:backend": "node ./node_modules/turbo/bin/turbo run dev --filter=backend",
    "dev:mobile": "node ./node_modules/turbo/bin/turbo run dev --filter=mobile"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
